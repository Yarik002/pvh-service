# Файлы и каталоги, которые не нужно передавать в образ.
# Зависимости ставятся внутри образа, база данных и настройки
# подключаются при запуске контейнера.

node_modules
data

# Система контроля версий
.git
.gitignore

# Настройки с паролями: передаются через переменные окружения
.env
.env.docker

# Файлы Docker: внутри образа не нужны
Dockerfile
docker-compose.yml
.dockerignore

# Материалы практики и редактора
Разработка
.vscode
.idea
coverage

# Модульные тесты и документация в рабочем образе не используются
tests
docs
