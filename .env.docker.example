# =====================================================================
#  Образец настроек для запуска в контейнерах (docker compose).
#
#  Порядок использования:
#    1) скопируйте файл:   copy .env.docker.example .env.docker
#    2) заполните значения;
#    3) раскомментируйте в docker-compose.yml строки сервиса app:
#
#         env_file:
#           - .env.docker
#
#    4) перезапустите:     docker compose up -d
#
#  Файл .env.docker не попадает в репозиторий: в нём хранится пароль
#  от почтового ящика.
# =====================================================================

# --- Адрес, по которому открывается приложение -----------------------
# Подставляется в ссылку подтверждения внутри письма. Обязательно
# исправьте, если приложение размещено не на локальном компьютере:
# ссылка из письма должна вести туда, где открывается сайт.
APP_BASE_URL=http://127.0.0.1:3000

# --- Отправка почты --------------------------------------------------
# ВАРИАНТ А: проверка без почтового ящика.
#   Письма принимает встроенный перехватчик mailpit, смотреть их нужно
#   по адресу http://127.0.0.1:8025. В интернет ничего не уходит.
#   Эти значения уже заданы в docker-compose.yml, поэтому вариант А
#   работает сразу после docker compose up, без данного файла.
#   Ниже они приведены для полноты.
MAIL_TRANSPORT=smtp
MAIL_FROM=no-reply@pvh.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# ВАРИАНТ Б: реальная отправка через Gmail.
#   Требуется пароль приложения (16 букв). Обычный пароль от почты
#   не подойдёт: Gmail отклонит его с ошибкой 535.
#   Получение: myaccount.google.com → Безопасность → Двухэтапная
#   аутентификация → Пароли приложений.
#   Адрес отправителя и логин должны совпадать, иначе Gmail подменит
#   отправителя на свой адрес.
#   Для этого варианта закомментируйте блок варианта А выше
#   и раскомментируйте строки ниже.
#
# MAIL_TRANSPORT=smtp
# MAIL_FROM=erder101@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_REQUIRE_TLS=false
# SMTP_USER=erder101@gmail.com
# SMTP_PASSWORD=вставьте_пароль_приложения

# --- Учётная запись администратора -----------------------------------
# Создаётся при первом запуске контейнера. Значения по умолчанию заданы
# в docker-compose.yml; здесь их можно переопределить.
#
# ADMIN_EMAIL=admin@pvh.local
# ADMIN_NAME=Администратор ПВЗ
# ADMIN_PASSWORD=Admin#2026Pvh
# SEED_CELLS_COUNT=20

# Адрес локального веб-ящика: показывается после регистрации, если
# письма принимает перехватчик (mailpit). Оставьте пустым, если
# письма уходят настоящим получателям.
MAIL_MAILBOX_URL=
