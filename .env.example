# =====================================================================
#  Настройки окружения приложения «Сервис трекинга заказов и инвентаря для ПВЗ»
#  Скопируйте этот файл в .env и при необходимости измените значения.
#  Файл .env в репозиторий не попадает (см. .gitignore).
# =====================================================================

# --- Сервер ---------------------------------------------------------
# Порт, на котором слушает HTTP-сервер
PORT=3000
# Интерфейс прослушивания (127.0.0.1 — только локально, 0.0.0.0 — вся сеть)
HOST=127.0.0.1
# Режим работы: development | production | test
NODE_ENV=development

# --- База данных SQLite ---------------------------------------------
# Путь к файлу базы данных (относительно корня проекта).
# Для тестов удобно указать :memory:
DB_FILE=./data/pvh.db
# Выводить в консоль выполняемые SQL-запросы (true/false)
DB_VERBOSE=false
# Автоматически применять миграции при старте сервера (true/false)
DB_AUTO_MIGRATE=true

# --- Логирование ----------------------------------------------------
# Уровень подробности: error | warn | info | debug
LOG_LEVEL=info

# --- Защита от перебора (ограничение частоты запросов) ---------------
# Длительность окна в миллисекундах (900000 = 15 минут)
RATE_LIMIT_WINDOW_MS=900000
# Предельное число попыток регистрации за окно с одного IP-адреса
RATE_LIMIT_MAX=20
# Предельное число запросов повторной отправки письма за окно
RESEND_LIMIT_MAX=5
# Предельное число попыток подтверждения адреса по токену за окно
CONFIRM_LIMIT_MAX=20
# Предельное число запросов проверки надёжности пароля за окно
PASSWORD_CHECK_MAX=200
# Предельное число попыток входа за окно (защита от подбора пароля)
LOGIN_LIMIT_MAX=10

# --- Сессии авторизации ----------------------------------------------
# Срок действия сессии в часах (168 = 7 суток)
SESSION_TTL_HOURS=168

# --- Начальная настройка данных (npm run seed) ------------------------
# Учётная запись администратора, создаваемая при первом запуске проекта.
# Если ADMIN_PASSWORD не задан, используется пароль по умолчанию —
# смените его после первого входа.
ADMIN_EMAIL=admin@pvh.local
ADMIN_NAME=Администратор ПВЗ
ADMIN_PASSWORD=
# Сколько ячеек хранения должно быть в справочнике
SEED_CELLS_COUNT=20

# --- Адрес приложения -----------------------------------------------
# Используется для ссылок в письмах (ссылка подтверждения адреса почты)
APP_BASE_URL=http://127.0.0.1:3000

# --- Отправка почты --------------------------------------------------
# Режим отправки:
#   log  — письмо выводится в журнал сервера (режим по умолчанию;
#          позволяет проверить регистрацию без реального почтового ящика);
#   smtp — письмо отправляется через почтовый сервер по протоколу SMTP.
MAIL_TRANSPORT=log

# Имя и адрес отправителя писем
MAIL_FROM_NAME=Сервис трекинга заказов и инвентаря для ПВЗ
MAIL_FROM=no-reply@pvh-service.local
# Адрес для ответов на письмо (необязательно)
MAIL_REPLY_TO=

# Параметры почтового сервера (заполняются при MAIL_TRANSPORT=smtp)
# Пример для Mail.ru: SMTP_HOST=smtp.mail.ru, SMTP_PORT=465, SMTP_SECURE=true
# Пример для Gmail:   SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# Для внешних сервисов требуется «пароль приложения», а не пароль от ящика.
SMTP_HOST=
SMTP_PORT=465
# Неявное шифрование TLS: true для порта 465, false для порта 587 (STARTTLS)
SMTP_SECURE=true
# Запрещать отправку без шифрования (true — рекомендуется)
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
# Таймаут ожидания ответа почтового сервера, миллисекунды
SMTP_TIMEOUT=20000

# Срок действия ссылки подтверждения адреса почты, часы
MAIL_CONFIRM_TTL_HOURS=24
# Адрес локального веб-ящика: показывается после регистрации, если письма
# принимает перехватчик (mailpit). Оставьте пустым для реальной почты.
MAIL_MAILBOX_URL=
