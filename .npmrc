# =====================================================================
#  Настройки пакетного менеджера npm (.npmrc).
#
#  Внимание: начиная с pnpm 11 из этого файла читаются только параметры
#  registry и авторизации. Структура node_modules задаётся в файле
#  pnpm-workspace.yaml (nodeLinker: hoisted).
#
#  Файл оставлен для совместимости при установке зависимостей через npm.
# =====================================================================

save-exact=false
fund=false
audit=false
