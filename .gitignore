# --- Зависимости ----------------------------------------------------
node_modules/
.pnpm-store/

# --- Переменные окружения -------------------------------------------
# Файлы содержат пароли и в репозиторий не добавляются.
# Образцы для заполнения: .env.example и .env.docker.example
.env
.env.local
.env.*.local
.env.docker

# --- База данных ----------------------------------------------------
# Файлы SQLite создаются при первом запуске и не хранятся в репозитории
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
!data/.gitkeep

# --- Внешние программы ----------------------------------------------
# Перехватчик писем mailpit (tools/mailpit.exe) скачивается отдельно
# и в репозиторий не добавляется: это около 27 МБ
tools/

# --- Логи -----------------------------------------------------------
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# --- Редакторы и ОС -------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
~$*

# --- Прочее ---------------------------------------------------------
coverage/
dist/
.DS_Store
