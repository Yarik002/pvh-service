# --- Зависимости ----------------------------------------------------
node_modules/
.pnpm-store/

# --- Переменные окружения -------------------------------------------
.env
.env.local
.env.*.local

# --- База данных ----------------------------------------------------
# Файлы SQLite создаются при первом запуске и не хранятся в репозитории
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
!data/.gitkeep

# --- Логи -----------------------------------------------------------
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# --- Редакторы и ОС -------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
~$*

# --- Прочее ---------------------------------------------------------
coverage/
dist/
.DS_Store
