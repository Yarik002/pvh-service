{
  "info": {
    "_postman_id": "c8e5a3b4-6d1f-4a43-be8c-3f2d4e9a7c56",
    "name": "ПВЗ — пароли (день 4)",
    "description": "Коллекция запросов для проверки надёжности пароля и правил хеширования (4-й день учебной практики).\n\nПорядок работы:\n1. Запустить сервер: npm start\n2. Выбрать окружение «ПВЗ — локальный сервер»\n3. Выполнять запросы по порядку.\n\nКоллекция проверяет две вещи:\n• эндпоинт POST /api/password/strength — оценка надёжности пароля и рекомендации;\n• правила регистрации — ненадёжные пароли должны отклоняться.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Оценка стойкого пароля (высокая надёжность)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Оценка не ниже 70 баллов', function () {",
              "    pm.expect(pm.response.json().strength.score).to.be.at.least(70);",
              "});",
              "",
              "pm.test('Уровень надёжности — высокий', function () {",
              "    pm.expect(['strong', 'veryStrong']).to.include(pm.response.json().strength.level);",
              "});",
              "",
              "pm.test('Замечаний нет', function () {",
              "    pm.expect(pm.response.json().strength.warnings).to.be.an('array').that.is.empty;",
              "});",
              "",
              "pm.test('Ответ не содержит сам пароль', function () {",
              "    pm.expect(pm.response.text()).to.not.include('Xk9#mQ2$vL7p');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"Xk9#mQ2$vL7p\",\n  \"name\": \"Иванов Иван\",\n  \"email\": \"ivanov@mail.ru\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/password/strength",
          "host": ["{{baseUrl}}"],
          "path": ["api", "password", "strength"]
        },
        "description": "Стойкий пароль: длинный, с разными типами символов, без словарных слов."
      }
    },
    {
      "name": "2. Оценка часто используемого пароля (низкая надёжность)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Оценка ниже 40 баллов', function () {",
              "    pm.expect(pm.response.json().strength.score).to.be.below(40);",
              "});",
              "",
              "pm.test('Есть рекомендации по улучшению', function () {",
              "    pm.expect(pm.response.json().strength.warnings.length).to.be.above(0);",
              "});",
              "",
              "pm.test('Проверка «отсутствует в словаре» не пройдена', function () {",
              "    const checks = pm.response.json().strength.checks;",
              "    const common = checks.find(function (c) { return c.id === 'notCommon'; });",
              "    pm.expect(common.passed).to.eql(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"qwerty123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/password/strength",
          "host": ["{{baseUrl}}"],
          "path": ["api", "password", "strength"]
        },
        "description": "Пароль из словаря часто используемых: 9 символов, но подбирается мгновенно."
      }
    },
    {
      "name": "3. Оценка пароля с личными данными",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Проверка «без личных данных» не пройдена', function () {",
              "    const checks = pm.response.json().strength.checks;",
              "    const personal = checks.find(function (c) { return c.id === 'noPersonalData'; });",
              "    pm.expect(personal.passed).to.eql(false);",
              "});",
              "",
              "pm.test('Есть рекомендация не использовать имя и почту', function () {",
              "    const checks = pm.response.json().strength.checks;",
              "    const personal = checks.find(function (c) { return c.id === 'noPersonalData'; });",
              "    pm.expect(personal.advice).to.include('имя');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"ivanovXk9#mQ2\",\n  \"name\": \"Иванов Иван\",\n  \"email\": \"ivanov@mail.ru\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/password/strength",
          "host": ["{{baseUrl}}"],
          "path": ["api", "password", "strength"]
        },
        "description": "Проверка, что пароль не содержит имени, фамилии и адреса электронной почты."
      }
    },
    {
      "name": "4. Пароль не указан (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Сообщение понятно пользователю', function () {",
              "    pm.expect(pm.response.json().error.message).to.include('пароль');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{baseUrl}}/api/password/strength",
          "host": ["{{baseUrl}}"],
          "path": ["api", "password", "strength"]
        },
        "description": "Пустой запрос должен отклоняться с понятным сообщением."
      }
    },
    {
      "name": "5. Регистрация отклоняет часто используемый пароль (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Код ошибки связан со слабым паролем', function () {",
              "    const code = pm.response.json().error.details.password.code;",
              "    pm.expect(['COMMON_PASSWORD', 'WEAK_PASSWORD']).to.include(code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Иванов Иван\",\n  \"email\": \"qwerty_test@mail.ru\",\n  \"password\": \"qwerty123\",\n  \"passwordConfirm\": \"qwerty123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Формально пароль длиннее 8 символов, но он есть в словаре — регистрация должна быть отклонена."
      }
    },
    {
      "name": "6. Регистрация отклоняет пароль с личными данными (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Код ошибки — CONTAINS_PERSONAL_DATA', function () {",
              "    pm.expect(pm.response.json().error.details.password.code).to.eql('CONTAINS_PERSONAL_DATA');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Иванов Иван\",\n  \"email\": \"ivanov_test@mail.ru\",\n  \"password\": \"ivanovXk9#mQ2\",\n  \"passwordConfirm\": \"ivanovXk9#mQ2\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Пароль содержит фамилию из адреса электронной почты — должен быть отклонён."
      }
    },
    {
      "name": "7. Регистрация со стойким паролем (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Возвращена оценка надёжности пароля', function () {",
              "    pm.expect(pm.response.json().passwordStrength.score).to.be.at.least(70);",
              "});",
              "",
              "pm.test('Хеш пароля не возвращается', function () {",
              "    pm.expect(pm.response.json().user).to.not.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Кирдун Ян\",\n  \"email\": \"day4-demo@mail.ru\",\n  \"password\": \"Xk9#mQ2$vL7p\",\n  \"passwordConfirm\": \"Xk9#mQ2$vL7p\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Стойкий пароль принимается, в ответе возвращается его оценка. При повторном запуске ожидается 409."
      }
    }
  ]
}
